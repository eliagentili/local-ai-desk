{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Desk 2",
  "version": "0.3.0",
  "identifier": "it.local.localaidesk2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI Desk 2",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Il workspace AI privato che lavora sul tuo computer.",
    "longDescription": "Elabora documenti, PDF, audio e video con motori AI locali e una libreria privata sul dispositivo.",
    "resources": {
      "../engine/backend": "engine/backend",
      "../engine/scripts": "engine/scripts",
      "../engine/requirements-core.txt": "engine/requirements-core.txt",
      "../engine/requirements-tools.txt": "engine/requirements-tools.txt",
      "../engine/requirements-paddle.txt": "engine/requirements-paddle.txt",
      "../engine/runtime-manifest.json": "engine/runtime-manifest.json"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
